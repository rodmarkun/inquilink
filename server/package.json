{
  "name": "@inquilink/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "email:dispatch": "EMAIL_WORKER_ONCE=true tsx src/workers/email.ts",
    "email:worker": "tsx src/workers/email.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^6.1.1",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.7",
    "sharp": "^0.35.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.12",
    "@readme/openapi-parser": "^7.0.1",
    "@types/node": "^24.6.2",
    "@types/nodemailer": "^8.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
